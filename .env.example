# TaskParty environment variables
# Copy to .env.local for development. Never commit real values.

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
NODE_ENV=development

# --- Clerk (docs/08-auth-and-permissions.md) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# --- Supabase (docs/14-deployment-and-operations.md section 4) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=                      # pooled connection string (transaction mode), used by the app
DIRECT_DATABASE_URL=               # direct connection, used only for migrations

# --- Inngest ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="TaskParty <notifications@mail.taskparty.app>"
EMAIL_REPLY_DOMAIN=mail.example.com

# --- Storage ---
STORAGE_BUCKET_ATTACHMENTS=attachments
STORAGE_BUCKET_AVATARS=avatars
STORAGE_BUCKET_EXPORTS=exports

# --- Security ---
CONNECTIONS_ENCRYPTION_KEY=        # 32 bytes, base64, for connector credentials (AES-256-GCM)
WEBHOOK_SIGNING_SALT=              # mixed into per-webhook secrets on creation

# --- Rate limiting (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Bot protection (Cloudflare Turnstile, public forms) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Observability ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Billing (phase 2) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Connectors (phase 2) ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
MS_TEAMS_APP_ID=
MS_TEAMS_APP_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=

# --- Seeds (scripts/seed-beta.ts) ---
SEED_BETA_EMAILS=                  # JSON object of first name to email for the beta roster, so sign ins link to the seeded rows
CLERK_BETA_ORG_ID=                 # optional: the Clerk organization id of the TaskParty workspace
